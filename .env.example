# Copie para .env e substitua os valores antes de iniciar com Docker Compose.
POSTGRES_DB=minha_gibiteca
POSTGRES_USER=minha_gibiteca
POSTGRES_PASSWORD=troque-esta-senha
DB_PASSWORD=troque-esta-senha
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
# Opcional: chave do Google Books para segunda fonte ISBN. Nunca versione a chave real.
GOOGLE_BOOKS_API_KEY=
# Opcional: Biblioteca digital OneDrive. Veja docs/onedrive.md antes de habilitar.
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:8080/biblioteca-digital/onedrive/retorno
# Chave Base64 de 32 bytes, própria da instalação. Nunca versionar uma chave real.
ONEDRIVE_TOKEN_KEY=
# Alternativa sem aplicativo Azure próprio. Autorize cada conta conforme docs/onedrive-rclone.md.
RCLONE_ENABLED=false
RCLONE_EXECUTABLE=rclone
RCLONE_CONFIG_DIRECTORY=./data/rclone
